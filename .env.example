# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key
SUPABASE_SECRET_KEY=

# Use the running app's exact origin. Email links require a recipient-accessible HTTPS origin.
APP_ORIGIN=http://localhost:3001

# Outbound invitations (use a sender on your verified Resend domain)
RESEND_API_KEY=
TRIPTRACK_INVITE_FROM=

# Geoapify forward geocoding (required for real-world venue lookups)
GEOAPIFY_API_KEY=
